# Docker (docker compose up -d): postgres://chat:chat@localhost:5433/chat
DATABASE_URL=postgres://chat:chat@localhost:5433/chat
TEST_DATABASE_URL=postgres://chat:chat@localhost:5433/chat_test
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Image storage (S3-compatible). Dev: RustFS from docker compose.
# Production (Cloudflare R2): S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chat-media
S3_ACCESS_KEY_ID=chatdev
S3_SECRET_ACCESS_KEY=chatdev-secret
